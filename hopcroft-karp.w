@* 들어가며.
1935년에 Philip Hall이 물었다. 소녀들이 저마다 마음에 드는 소년의 명단을 냈을 때,
모두가 명단 안의 사람과 짝지어질 수 있으려면 어떤 조건이 필요한가? 답은 놀랍도록
간단했다. 소녀를 어떻게 몇 명 골라도 그들의 명단을 합친 것이 고른 수보다 적지 않으면
된다. 이것이 {\it 결혼 정리\/}다. 네 해 앞서 헝가리의 Dénes K\H onig와 Jen\H o Egerváry는
같은 사실을 다른 옷을 입혀 증명해 두었다---이분 그래프에서 짝짓기의 최대 크기는
모든 변을 건드리는 꼭짓점의 최소 개수와 같다는 것이다.

정리는 아름다웠지만 {\it 어떻게 찾는가\/}는 다른 문제였다. 1957년에 Claude Berge가
열쇠를 내놓았다. 짝짓기가 최대가 아니라면, 반드시 {\it 증대 경로\/}가 있다. 짝 없는
쪽에서 시작해 짝 아닌 변과 짝인 변을 번갈아 밟아 다시 짝 없는 쪽에서 끝나는 길이다.
그 길에서 변의 역할을 뒤집으면 짝이 하나 늘어난다. 그러니 증대 경로가 없을 때까지
찾으면 된다. 이 프로그램이 하는 일이 바로 그것인데, 한 번에 하나씩이 아니라
{\it 한 판에 여러 개씩\/} 찾는 것이 요령이다.

@ 이 프로그램은 크누스의 \.{CWEB} 프로그램 \pdfURL{\.{hopcroft-karp.w}}%
{https://www-cs-faculty.stanford.edu/\TILDE/knuth/programs/hopcroft-karp.w}를
\.{GWEB}으로 옮긴 것이다. John~E. Hopcroft와 Richard~M. Karp의 고전적인
알고리즘을 구현하고 설명한다 [``An $n^{5/2}$ algorithm for maximum matchings in
bipartite graphs,'' {\sl SIAM Journal on Computing\/} {\bf 2} (1973), 225--231].

표준 입력 |stdin|으로 들어오는 것은 $0$과 $1$로 이루어진 $m\times n$ 행렬
$(a_{ij})$이고, 한 줄이 한 행이다. 여기서 행은 ``소년,'' 열은 ``소녀''에
대응한다. (크누스는 이렇게 적어 두었다: ``물론 나는 영어의 표현력을 빌리려고
이렇게 하는 것이지, 남녀에 어떤 구별을 두려는 것이 아니다.'') 소년~$i$는
$a_{ij}=1$일 때만 소녀~$j$와 짝지을 수 있다. 되도록 많은 쌍을 짝지어 주는 것이
목표다. 알고리즘이 조금 빨라지므로 $m\le n$이라고 가정한다.

@ 부분 짝짓기가 하나 주어졌을 때(비어 있어도 좋다), {\it 증대 경로\/}란
$$g_0\adj b_0\addj g_1\adj b_1\addj\ \cdots\ \adj b_{k-1}\addj g_k\adj b_k$$
꼴의 단순 경로를 말한다. 여기서 $g_0$은 짝 없는 소녀이고, 소녀~$g_i$는 소년~$b_i$와
짝지을 수 있으며, $i<k$인 소년~$b_i$는 지금 소녀~$g_{i+1}$과 짝지어져 있고,
$b_k$는 짝 없는 소년이다. 증대라는 이름이 붙은 까닭은, 이것이 지금의 짝짓기를
개선하는 법을 알려 주기 때문이다: 있던 쌍 $k$개를 깨고 새 쌍 $k+1$개를 만들면
된다. 곧 $g_i$와 $b_i$를 서로 붙여 주면 된다.
$$\mplibcode fig_augment; \endmplibcode$$
\figcap{짝인 변은 겹선, 짝 아닌 변은 홑선으로 그렸다. 이 약속은 뒤의 그림에서도
같다. 왼쪽 길을 따라 겹선과 홑선을 맞바꾸면 오른쪽이 되고, 쌍이 둘에서 셋으로 는다.}

@ HK 알고리즘은 빈 짝짓기에서 시작해 {\it 판\/}을 거듭한다. 한 판에서는 서로
꼭짓점을 나눠 갖지 않는 증대 경로를, 그것도 가능한 가장 짧은 것들만 골라,
더 이상 못 고를 때까지 고른다. 여기서 $r$번째 판이 그런 경로를 $k$개 찾았다면 짝 없는
소년(과 소녀)의 수가 $k$만큼 줄어든다.

한 판은 $O(t+n)$걸음이면 끝난다. 여기서 $t=\sum a_{ij}$는 행렬 안의 $1$의 개수다.
최대 짝짓기의 크기를~$s$라 하면, $r$판을 마친 뒤의 부분 짝짓기가 언제나
${r\over r+1}s$쌍 이상을 이룬다는 것을 뒤에서 증명한다. 여기에 영리한 논증을
보태면 판은 많아야 $2\sqrt s$번이면 된다. 그래서 최악의 경우 실행 시간이
$O((t+n)\sqrt s\,)=O((t+n)\sqrt m\,)$으로 아주 얌전하다. (게다가 최악은 좀처럼
겪지 않는다. 운이 좋으면 첫 판에 최적을 맞혀 버리기도 한다.)

@ 뼈대는 이렇다. 판을 거듭하되, 한 판마다 최단 증대 경로의 dag를 짓고, 거기서
서로 겹치지 않는 경로를 끝까지 거두어 짝짓기에 반영한다. 짝 없는 소녀가 더는
줄지 않으면---곧 dag에 증대 경로가 하나도 없으면---끝이다.

@c
package main

import (
	"bufio"
	"fmt"
	"os"
	"strconv"
)

@<상수@>@;
@<전역 변수@>@;

func main() {
	@<지역 변수@>@;
	@<명령줄을 살핀다@>@;
	@<행렬을 읽어 성긴 자료 구조로 바꾼다@>@;
	for r, f = 1, n; f > n-m; r++ {
		@<판이 시작됨을 알린다@>@;
		@<첫 판이라면 욕심껏 해치우고 다음 판으로@>@;
		@<최단 증대 경로의 dag를 짓는다@>@;
		if finalLevel < 0 {
			break // 증대 경로가 없다
		}
		@<겹치지 않는 최단 증대 경로를 끝까지 거둔다@>@;
		@<판이 끝났음을 알린다@>@;
	}
	@<답을 알린다@>@;
}

@ 말수준을 나타내는 비트들이다. 크누스는 이것을 프로그램 안에 박아 두고 고쳐
컴파일하게 했는데, 여기서는 명령줄에서 정할 수 있게 했다. 마지막 비트
|showCover|는 원본에 없는 것으로, 뒤에서 이야기한다.

@<상수@>=
const (
	maxn = 1000  // $n$은 이보다 작아야 한다
	maxt = 10000 // $t$는 이보다 작아야 한다
)

@ @<상수@>=
const (
	showRounds   = 0x1  // 지금 몇 번째 판인지
	showPartials = 0x2  // 판마다의 부분 짝짓기
	showUpdates  = 0x4  // 증대 하나하나
	showDags     = 0x8  // 최단 증대 경로의 dag
	showAnswer   = 0x10 // 최대 짝짓기
	showCover    = 0x20 // 최소 꼭짓점 덮개
)

@ @<전역 변수@>=
var vbose uint = showRounds // 켜진 비트마다 곁들이는 출력이 늘어난다

@ 인자는 차례에 관계없이 받는다. 깃발 \.{-g}는 마지막 장에서 이야기할 빠른 첫
판을 켜고, 나머지는 말수준으로 읽는다.

@<명령줄을 살핀다@>=
for _, a := range os.Args[1:] {
	if a == "-g" {
		greedy = true
		continue
	}
	v, err := strconv.ParseUint(a, 0, 32)
	if err != nil {
		fmt.Fprintf(os.Stderr, "쓰는 법: %s [말수준] [-g]\n", os.Args[0])
		os.Exit(1)
	}
	vbose = uint(v)
}

@ 여기 모아 둔 것들이 판마다 쓰이는 값이다. 짝 없는 소녀의 수~|f|, 소년의 수~|m|,
소녀의 수~|n|, 판 번호~|r|, 변의 수~|t|, 그리고 dag의 꼭대기 층인 |finalLevel|.

@<지역 변수@>=
var b, f, g, i, j, k, l, m, n, p, q, qq, r, t, tt, marks, finalLevel int
var buf string
var in *bufio.Scanner
var greedy bool

@* 쉬운 것 (입력).
이 부분은 시시하지만, 대개 HK 알고리즘 자체보다 시간이 더 걸린다. ($0$--$1$ 행렬은
성긴 그래프를 담기에 효율적인 표현이 아니기 때문이다.) 잘못된 입력은 매몰차게
물리친다.

@<행렬을 읽어 성긴 자료 구조로 바꾼다@>=
@<첫 줄을 읽어 |n|을 정한다@>@;
@<소녀가 몇인지 따져 본다@>@;
for t, m = 0, 1; ; m++ {
	if m > n {
		fmt.Fprintf(os.Stderr, "소녀가 %d명뿐이니 소년이 %d명을 넘을 수 없다!\n", n, n)
		os.Exit(3)
	}
	@<소년 |m|이 짝지을 수 있는 소녀들을 적어 둔다@>@;
	if !in.Scan() {
		break
	}
	buf = in.Text()
	@<줄 길이를 따져 본다@>@;
}
fmt.Fprintf(os.Stderr, "좋다, 소년 %d명, 소녀 %d명, 있을 수 있는 짝 %d개짜리 행렬을 읽었다.\n",
	m, n, t)
@<나머지 자료 구조를 채비한다@>@;

@ @<첫 줄을 읽어 |n|을 정한다@>=
in = bufio.NewScanner(os.Stdin)
in.Buffer(make([]byte, maxn+2), maxn+2)
if in.Scan() {
	buf = in.Text()
}
n = len(buf)

@ @<소녀가 몇인지 따져 본다@>=
if n == 0 {
	fmt.Fprintln(os.Stderr, "소녀가 적어도 하나는 있어야 한다!")
	os.Exit(2)
} else if n >= maxn {
	fmt.Fprintf(os.Stderr, "나를 다시 컴파일해 다오: 소녀 %d명 이상은 감당하지 못한다!\n", maxn)
	os.Exit(2)
}

@ @<줄 길이를 따져 본다@>=
if len(buf) != n {
	fmt.Fprintf(os.Stderr, "소년 %d에 대한 입력이 소녀 %d명을 적고 있지 않다!\n", m+1, n)
	os.Exit(4)
}

@ 입력을 담는 자료 구조는 단순하다. 소녀~|j|와 짝지을 수 있는 소년들은 |glink[j]|에서
시작해 |next|로 이어지고 $0$으로 끝나는 목록에 들어 있다. 이음줄~|l|이 가리키는
소년은 |tip[l]|이다.

@<소년 |m|이 짝지을 수 있는 소녀들을 적어 둔다@>=
for j = n; j != 0; j-- {
	p = int(buf[j-1]) - '0'
	if p < 0 || p > 1 {
		fmt.Fprintf(os.Stderr, "소년 %d의 입력에 이상한 글자 `%c'가 있다!\n", m, buf[j-1])
		os.Exit(5)
	}
	if p != 0 {
		@<변 하나를 적어 넣는다@>@;
	}
}

@ @<변 하나를 적어 넣는다@>=
t++
if t >= maxt {
	fmt.Fprintf(os.Stderr, "나를 다시 컴파일해 다오: 있을 수 있는 짝 %d개 이상은 감당하지 못한다!\n", maxt)
	os.Exit(6)
}
tip[t] = m
next[t] = glink[j]
glink[j] = t

@ 뒤에 가서 소년 쪽 짝 후보에도 비슷한 자료 구조를 쓴다. 그래서 |next|와 |tip|은
$2t+m$개를 담을 수 있어야 한다: 원래 그래프에 $t$개, $0$번째 판의 변에 $t$개,
그리고 $\top$에서 나가는 변에 $m$개다.

@<전역 변수@>=
var (
	blink, glink [maxn]int                // 짝 후보 목록의 머리
	next, tip    [maxt + maxt + maxn]int  // 이음줄과 어울리는 짝
)

@* 더 쉬운 것 (출력).
소년마다 지금의 짝을 담는 |mate| 표가 있다. 소녀 쪽에는 |imate| 표가 있다.

@<전역 변수@>=
var mate, imate [maxn]int

@ 여기까지의 짝을 알리려면 소년마다 그 짝을 보이면 된다.

@<지금까지의 짝짓기를 보인다@>=
for p = 1; p <= m; p++ {
	fmt.Fprintf(os.Stderr, " %d", mate[p])
}
fmt.Fprintln(os.Stderr)

@ @<판이 시작됨을 알린다@>=
if vbose&showRounds != 0 {
	fmt.Fprintf(os.Stderr, "%d번째 판을 시작한다...\n", r)
}

@ 여기서 찍는 등급은 |finalLevel|에 하나를 더한 값이다. 변수 |finalLevel|은 증대 경로
하나가 깨뜨리는 기존의 짝의 수이고, 앞에서 정의한 등급---길이가 $2k-1$인 경로의
등급은 $k$---은 그보다 하나 크기 때문이다. 크누스의 원본은 |final_level|을 그대로
찍고 그것을 rank라 불렀는데, 정작 그가 정의한 rank는 하나 큰 쪽이다. 원문의 서술도
두 뜻 사이를 오간다. 여기서는 정의를 따랐다.

@ @<판이 끝났음을 알린다@>=
if vbose&showRounds != 0 {
	fmt.Fprintf(os.Stderr, " ... 이제 %d쌍이 짝지어졌다 (등급 %d).\n", n-f, finalLevel+1)
}
if vbose&showPartials != 0 {
	@<지금까지의 짝짓기를 보인다@>@;
}

@ 크누스의 원본은 판이 하나일 때 ``round''를, 여럿일 때 ``rounds''를 쓰려고
삼항 연산자를 두 번 겹쳐 썼다. 한국어에는 그런 수고가 없다.

@<답을 알린다@>=
if f == n-m {
	r-- // 마지막 판은 돌지 않았다
}
fmt.Fprintf(os.Stderr, "크기 %d짜리 최대 짝짓기를 %d판 만에 찾았다.\n", n-f, r)
if vbose&showAnswer != 0 {
	@<지금까지의 짝짓기를 보인다@>@;
}
if vbose&showCover != 0 {
	@<최소 꼭짓점 덮개를 알린다@>@;
}

@* 멋진 것 (최단 증대 경로의 dag).
너비 우선 탐색을 쓰면, $\top$이라 부르는 가짜 꼭짓점에서 $\bot$이라 부르는 또 다른
가짜 꼭짓점으로 가는 길이 최단 증대 경로와 일대일로 대응하는 방향 비순환 그래프
(dag)를 만들 수 있다. 그 길은 저마다 기존의 짝을 |finalLevel|개씩 지난다.

이 dag의 표현은 소녀 쪽 목록과 비슷하되 더 성기다. 소년~$i$에서 어울리는 소녀로
가는 첫 화살이 |blink[i]|에 있고, |tip|과 |next|는 앞서와 같다. 반면에 소녀에게는
나가는 화살이 딱 하나---그의 |imate|---뿐이다. 그 |imate|가 $0$이면 $\bot$으로 가는
이음줄이다. 나머지 가짜 꼭짓점 $\top$은 짝 없는 소년들의 목록을 가지는데,
그 머리가 |dlink|다.

@ 배열 |mark|는 소년이 dag의 몇 층에서 들어왔는지를 (하나 더해서) 적어 둔다.
시작할 때 모든 표시는 $0$이어야 한다.

@<최단 증대 경로의 dag를 짓는다@>=
finalLevel, tt = -1, t
marks, l, i, q = 0, 0, 0, f
for {
	qq = q
	for ; i < qq; i++ {
		g = queue[i]
		@<소녀 |g|를 원하는 소년들을 훑는다@>@;
	}
	if q == qq {
		break // 다음 층으로 넘길 것이 없다
	}
	l++
}

@ @<소녀 |g|를 원하는 소년들을 훑는다@>=
for k = glink[g]; k != 0; k = next[k] {
	b = tip[k]
	p = mark[b]
	if p == 0 {
		@<소년 |b|를 dag에 들인다@>@;
	} else if p <= l {
		continue
	}
	@<|b|에서 |g|로 가는 화살을 놓는다@>@;
}

@ 화살은 소년~|b|에서 소녀~|g|로, 그리고 곧바로 그의 짝으로 이어진다.

@<|b|에서 |g|로 가는 화살을 놓는다@>=
if vbose&showDags != 0 {
	fmt.Fprintf(os.Stderr, " %d->%d=>%d\n", b, g, imate[g])
}
tt++
tip[tt] = g
next[tt] = blink[b]
blink[b] = tt

@ 꼭대기 층에 이르렀다는 것을 안 뒤로는, 그 층에 짝 없는 소년만 더 들인다.
아울러 |q|를 |qq|로 되돌려, dag가 더 높은 층으로 자라지 못하게 한다.

@<소년 |b|를 dag에 들인다@>=
if finalLevel >= 0 && mate[b] != 0 {
	continue
} else if finalLevel < 0 && mate[b] == 0 {
	finalLevel, dlink, q = l, 0, qq
}
mark[b] = l + 1
marked[marks] = b
marks++
blink[b] = 0
if mate[b] != 0 {
	queue[q] = mate[b]
	q++
} else {
	@<짝 없는 소년 |b|를 $\top$의 목록에 붙인다@>@;
}

@ @<짝 없는 소년 |b|를 $\top$의 목록에 붙인다@>=
if vbose&showDags != 0 {
	fmt.Fprintf(os.Stderr, " top->%d\n", b)
}
tt++
tip[tt] = b
next[tt] = dlink
dlink = tt

@ @<전역 변수@>=
var (
	queue  [maxn]int // 너비 우선 탐색에서 본 소녀들
	iqueue [maxn]int // 앞의 |f|칸에 대한 역순열
	mark   [maxn]int // 소년이 dag의 어디에 나타나는가
	marked [maxn]int // 표시가 붙은 소년들
	dlink  int       // dag 안 짝 없는 소년 목록의 머리
)

@ @<모든 표시를 지운다@>=
for marks != 0 {
	marks--
	mark[marked[marks]] = 0
}

@* 나아가기.
방금 우리는 최단 증대 경로의 dag를 지었다. 바닥의 가짜 꼭짓점 $\bot$에서 시작해
너비 우선으로 올라가며 |finalLevel|을 알아내고 사실상 가짜 꼭짓점 $\top$에
닿았다. 이제 그 과정을 어느 정도 거꾸로 밟는다. 가짜 꼭짓점 $\top$에서 시작해 이번에는
{\it 깊이\/} 우선으로 내려가며, 서로 꼭짓점을 나눠 갖지 않는 증대 경로를 더는
못 고를 때까지 거둔다. (어느 극대 집합이든 상관없다. 특별히 큰 것을 찾으려고
애쓸 필요가 없다.)

@ dag는 최단 증대 경로가 하나씩 빠져나갈 때마다 조금씩 헐린다. 그래야 거기 쓰인
소년과 소녀가 다시 쓰이지 않는다. 여기에 미묘한 데가 하나 있다. 앞서 거둔 경로에
들어 있던 소녀~|g|를 다시 만나면, 그의 짝은 이미 |mark|가 음수인 소년으로 바뀌어
있다. 층이 |l=0|이고 |g|가 원래 짝이 없던 소녀였더라도 그렇다.

@<겹치지 않는 최단 증대 경로를 끝까지 거둔다@>=
for dlink != 0 {
	b, dlink = tip[dlink], next[dlink]
	l = finalLevel
	boy[l] = b
	@<한 갈래를 깊이 우선으로 따라간다@>@;
}
@<모든 표시를 지운다@>@;

@ 크누스는 이 대목을 |goto| 둘---|enter_level|과 |advance|---로 적었다. \GO/에도
|goto|가 있지만, 여기서는 반복문 하나로 고쳐 적는 편이 낫다. 여기서 |continue|가 곧
|advance|로 가는 것이고, 층을 내려갈 때 |boy[l]|을 적어 두는 것이 |enter_level|이
하던 일이다. 그리고 |break|는 이 갈래를 접고 $\top$의 다음 소년으로 넘어간다는 뜻이다.

@<한 갈래를 깊이 우선으로 따라간다@>=
for {
	if blink[b] != 0 {
		@<화살을 하나 따라간다@>@;
	}
	l++
	if l > finalLevel {
		break // 이 갈래에는 증대 경로가 없다
	}
	b = boy[l] // 한 층 물러선다
}

@ 소년~|b|에게 아직 안 써 본 화살이 있으면 그것을 뽑아 쓴다. 그 끝의 소녀가
짝이 없으면 증대 경로를 하나 찾은 것이고, 아니면 그의 짝에게로 한 층 내려간다.
표 |mark|가 음수인 소년은 이미 다른 경로가 데려갔으니 건너뛴다.

@<화살을 하나 따라간다@>=
g = tip[blink[b]]
blink[b] = next[blink[b]]
if imate[g] == 0 {
	@<짝짓기를 늘리고 이 갈래를 접는다@>@;
}
if mark[imate[g]] >= 0 {
	b, l = imate[g], l-1
	boy[l] = b
}
continue

@ 여기서 $|g|=g_0$이고 $|b|=|boy[0]|=b_0$이 증대 경로의 첫머리다. 나머지 소년들은
|boy[1]|, |boy[2]|, 하는 식으로 놓여 있다. 짝을 바꿔 나가면서 |mark|를 $-1$로
찍어 두어, 이 판에서 다시 쓰이지 않게 한다.

@<짝짓기를 늘리고 이 갈래를 접는다@>=
if l != 0 {
	fmt.Fprintln(os.Stderr, "어리둥절하다!")
} // 짝 없는 소녀는 $0$층에만 있어야 한다
@<짝 없는 소녀 목록에서 |g|를 뺀다@>@;
for {
	@<짝 하나가 바뀌었음을 알린다@>@;
	mark[b] = -1
	j = mate[b]
	mate[b] = g
	imate[g] = b
	if j == 0 {
		break // |b|에게 짝이 없었다
	}
	l++
	g, b = j, boy[l]
}
if vbose&showUpdates != 0 {
	fmt.Fprintln(os.Stderr)
}
break

@ @<짝 하나가 바뀌었음을 알린다@>=
if vbose&showUpdates != 0 {
	head := " 짝"
	if l != 0 {
		head = ","
	}
	fmt.Fprintf(os.Stderr, "%s %d-%d", head, b, g)
}

@ @<전역 변수@>=
var boy [maxn]int // 깊이 우선 탐색에서 훑고 있는 소년들

@ 행렬을 읽을 때 우리는 |glink[g]|가 처음에 모두 $0$이라고 슬그머니 가정했다.
층 그래프 dag를 지을 때는 |blink[b]|를 그때그때 $0$으로 놓았다. 배열 |queue|와
|iqueue|는 $0$이 아닌 값으로 채워야 하니 여기서 해 둔다.

@<나머지 자료 구조를 채비한다@>=
for g = 1; g <= n; g++ {
	queue[g-1] = g
	iqueue[g] = g - 1
}

@ 짝 없는 소녀는 |queue|의 앞쪽 |f|칸에 모여 있고, |iqueue|가 그 자리를 알려 준다.
하나를 뺄 때는 맨 뒤의 것을 빈자리로 옮기면 된다. 너비 우선 탐색의 대기열이 같은
배열을 이어 쓰지만, 그 탐색은 이미 끝난 뒤라 |queue[f]| 자리를 덮어써도 괜찮다.

@<짝 없는 소녀 목록에서 |g|를 뺀다@>=
f-- // |f|는 짝 없는 소녀의 수
j = iqueue[g]
i = queue[f]
queue[j] = i
iqueue[i] = j

@* 왜 되는가.
HK 알고리즘은 그래프의 짝짓기에 대한 간단한 보조정리 셋에 기대고 있다. 그래프~$G$의
{\it 짝짓기\/}란 모든 꼭짓점의 차수가 $1$ 이하인 $G$의 부분그래프임을 떠올리자.

같은 그래프~$G$ 안의 짝짓기 $A$와 $B$가 있다고 하고, $A\oplus B$를 둘 중 하나에만
드는 변들의 모임이라 하자. 이것은 모든 꼭짓점의 차수가 $2$ 이하인 부분그래프이므로,
$A\oplus B$의 연결 성분은 모두 순환 아니면 경로다.

@ 대칭차 $A\oplus B$ 안의 순환은 길이가 짝수여야 한다. 두 짝짓기의 변이 번갈아
나오기 때문이다. 이를테면 가장 짧은 순환은
$$v_0\adj v_1\addj v_2\adj v_3\addj v_4$$
같은 $4$-순환이다. 여기서 `$\,\adj\,$'는 $A$의 변을, `$\,\addj\,$'는 $B$의 변을
뜻한다.

대칭차 $A\oplus B$ 안의 경로는 길이가 홀수일 수도 짝수일 수도 있다. 꼭짓점이 $2k+1$개라
길이가 $2k$이면 반드시 ``균형''을 이루어 $A$에서 $k$개, $B$에서 $k$개를 가져온다.
그러나 꼭짓점이 $2k$개라 길이가 $2k-1$이면 $A$-경로($A$에서 $k$개, $B$에서
$k-1$개)이거나 $B$-경로($B$에서 $k$개, $A$에서 $k-1$개)여야 한다. 길이가
$2k-1$인 경로를 두고 {\it 등급\/}이 $k$라고 한다.
$$\mplibcode fig_symdiff; \endmplibcode$$
\figcap{$A\oplus B$의 성분 네 가지. 실선이 $A$, 겹선이 $B$다. 순환과 균형 경로는
양쪽에서 같은 수를 가져가고, $A$-경로만 $A$ 쪽이 하나 많다.}

@ 그러므로 등급 $1$, $2$, $3$, \dots의 $A$-경로는 이렇게 생겼다:
$$v_0\adj v_1,
\qquad
v_0\adj v_1\addj v_2\adj v_3,
\qquad
v_0\adj v_1\addj v_2\adj v_3\addj v_4\adj v_5,
\qquad\ldots\,;$$
$B$-경로도 비슷하되 `$\,\adj\,$'와 `$\,\addj\,$'가 뒤바뀐다.

성분 가운데 $c_A$개가 $A$-경로, $c_B$개가 $B$-경로, $c_0$개가 순환이거나 균형
경로라 하자. 그러면 $c_A-c_B=\vert A\vert-\vert B\vert$인데, 여기서 $\vert A\vert$는
$A$에 든 변의 수다. 이를테면 $\vert A\vert=15$이고 $\vert B\vert=12$라면 $A$-경로가
다섯에 $B$-경로가 둘일 수도, 넷에 하나일 수도 있다. 어느 쪽이든 $A\oplus B$에는
$A$-경로가 적어도 셋 있어야 한다.

@ 눈여겨볼 것은 모든 $A$-경로가 $B$에 대한 증대 경로이고, 모든 $B$-경로가 $A$에
대한 증대 경로라는 점이다. 그러므로 다음이 성립한다.
\smallskip\noindent
{\bf 보조정리 1.}\enspace
{\sl $A$와 $B$가 $G$의 짝짓기이고 $\vert A\vert>\vert B\vert$이면, $B$에는 서로
꼭짓점을 나눠 갖지 않는 증대 경로가 적어도 $\vert A\vert-\vert B\vert$개 있다.}
\smallskip\noindent
{\it 증명.}\enspace
$A\oplus B$의 $A$-경로들은 서로 꼭짓점을 나눠 갖지 않는다.\quad\slug

\smallskip
그러니 최대 짝짓기의 크기가 $s$이고 $B$가 $\vert B\vert=r$인 아무 짝짓기라면,
서로 겹치지 않는 증대 경로가 $s-r$개 있어야만 한다. 그것이 무엇인지는 모르지만
있다는 것은 안다. 증대 경로가 하나도 없음을 알아냈을 때 HK 알고리즘이 최대
짝짓기를 찾았다고 확신하는 근거가 바로 이것이다.

@ 이제 증대가 어떤 효과를 내는지 보자. 이를테면
$$v_0\adj v_1\addj v_2\adj v_3\addj v_4\adj v_5
\qquad\hbox{를}\qquad
v_0\adddj v_1\addj v_2\adddj v_3\addj v_4\adddj v_5$$
로 바꾸고 $B$의 나머지 변은 그대로 두어 새 짝짓기~$C$를 만들었다고 하자.
대칭차 $A\oplus C$의 성분은 어떻게 되는가? 답은 이렇다. 자취 $\{v_0,v_1,\ldots,v_5\}$의 모든
꼭짓점이 $A\oplus C$에서 외톨이(차수 $0$)가 되므로, $A\oplus B$의 $A$-성분 하나가
사실상 사라진다. 그러나 $A\oplus B$의 {\it 다른\/} 모든 성분은 $A\oplus C$에서
그대로인데, 다만 `$\,\addj\,$'가 `$\,\adddj\,$'로 바뀔 뿐이다. 그 성분들은
$\{v_0,\ldots,v_5\}$를 하나도 건드리지 않기 때문이다. (특히 균형 성분은 균형인
채로, $A$-경로는 $A$-경로인 채로 남고, $B$-경로는 $C$-경로가 된다.)

@ 알고리즘 HK가 실제로 다루는 것은 $B$에 대한 {\it 최단\/} 증대 경로뿐이다.
곧 등급~$k$가 가장 작은 $A$-경로들이다. 알고리즘은 그런 경로를 서로 겹치지 않게
$q$개 찾아, 그것으로 $\vert C\vert=q+r$인 더 큰 짝짓기~$C$를 얻는다. 게다가
알고리즘은 등급~$k$인 {\it 다른\/} 모든 증대 경로에 $C$에서의 짝이 $B$에서의
짝과 달라진 꼭짓점~$v$가 적어도 하나 있다는 것을 안다. (그런 다른 최단 경로들도
dag를 지을 때는 있었지만, 끝내 헐려 없어졌다.)
\smallskip\noindent
{\bf 보조정리 2.}\enspace
{\sl 그 상황에서 짝짓기 $C$의 모든 증대 경로는 등급이 $k$보다 크다.}
\smallskip\noindent
{\it 증명.}\enspace
증대는 성분을 지워 없앨 뿐 더 짧은 것을 만들지 않는다. 남은 문제는 $C$에 대해
등급~$k$인 $A$-경로가 아직 있느냐인데, 그런 경로는 그 꼭짓점 가운데 하나가 처음
새 짝을 얻는 순간 모두 사라졌다.\quad\slug

@ 여기서 예를 하나 보면 도움이 된다. 소녀 $\{x_1,\ldots,x_n\}$과 소년
$\{y_1,\ldots,y_n\}$으로 이루어진 이분 그래프를 생각하자. 소녀 $x_i$는 $i\le j$일 때만
$y_j$와 짝지을 수 있다. 이 그래프의 짝짓기는 완전한 것이 딱 하나다. 소녀 $x_n$은
$y_n$하고만 짝지을 수 있고, 그러면 $x_{n-1}$은 $y_{n-1}$하고만, 하는 식이기
때문이다.

이제 $A$를 그 완전 짝짓기라 하고 $B$를 빈 짝짓기라 하면, $i\le j$인 모든 변
$x_i\adj y_j$가 등급~$1$의 $A$-경로다. 그런 {\it 겹치지 않는\/} $A$-경로의
모임 하나는
$$x_1\adj y_2,\qquad x_2\adj y_3,\qquad \cdots{},\qquad x_{n-1}\adj y_n$$
이고, 이것은 {\it 극대\/}다. 빠진 것이 $x_n$과 $y_1$뿐인데 이 둘은 짝지을 수
없기 때문이다.

@ 그 경로들로 $B$를 모두 증대하면 변이 $n-1$개인 짝짓기~$C$를 얻는다:
$$x_1\adddj y_2,\qquad x_2\adddj y_3,\qquad \cdots{},\qquad x_{n-1}\adddj y_n.$$
보조정리 2에 따라 $C$에는 등급~$1$인 증대 경로가 없다. 실제로 $C$의 증대 경로는
$$y_1\adj x_1\adddj y_2\adj x_2\adddj y_3\adj x_3 \cdots{}\adj
x_{n-1}\adddj y_n\addj x_n$$
하나뿐이고 그 등급은 $n$이다.

(이 예에서 소녀를 $n!$가지 가운데 아무렇게나 늘어놓고, 소년도 따로 $n!$가지 가운데
아무렇게나 늘어놓아 $0$과 $1$의 행렬로 이 프로그램에 먹여 보라. 놀랍게도, 첫 판에
지어지는 dag의 목록 차례가 언제나 최적의 최대 짝짓기를 곧바로 찾아내도록 놓여
두 번째 판이 필요 없다. 그러니 이 알고리즘의 미묘한 부분을 시험해 볼 좋은
자료를 만드는 일은 생각만큼 쉽지 않다.)

@ 방금 것은 극단적인 예였다. 첫 판에서 찾는 최단 증대 경로는 언제나 등급~$1$이고,
두 번째 판의 것은 대개 ($n$이 아니라) 등급~$2$다. 그리고 일반적으로, $r$판을
마친 뒤에 남는 증대 경로는 등급이 $r+1$ 이상이라는 것을 우리는 안다.

최대 짝짓기~$A$의 변이 $s$개이고 $r$번째 판에서 크기~$q$인 짝짓기~$B$를 얻었다고
하자. 만약 $q<{r\over r+1}s$라면, 보조정리 1과 2에 따라 등급 $r+1$ 이상인 겹치지
않는 증대 경로가 $s-q$개 있다. 등급이 $k$인 경로는 $A$의 변을 $k$개 품으므로,
$A$의 서로 다른 변이 모두 $(r+1)(s-q)$개 이상 있는 셈이다. 그런데 이것은
$(r+1)(s-{r\over r+1}s)=s$보다 크다. 모순이다! 이렇게 증명했다.
\smallskip\noindent
{\bf 보조정리 3.}\enspace
{\sl $r$번째 판을 마친 뒤의 짝짓기는 최종 짝짓기의 ${r\over r+1}$배 이상이다.}
\quad\slug

\smallskip
그래서 Hopcroft와 Karp는 이렇게 말했다. ``아하! 여기서 $r=\lceil\sqrt s-1\rceil$번째
판을 보라. 거기서 이미 ${r\over r+1}s\ge s-\sqrt s$개 이상이 짝지어져 있다.
그러니 많아야 $\sqrt s$판만 더 돌면 끝난다.''\quad\slug

@ 덧붙이자면, 보조정리 1과 2의 증명은 이분이든 아니든 {\it 어떤\/} 그래프에서나
통한다. 이분이라는 성질은 최단 증대 경로 전부의 dag를 지을 방법을 준다는 데에만
썼다.

Hopcroft와 Karp는 이 방법을 이분이 아닌 일반 그래프로 넓히기를 바란다고 적었다.
아마도 Jack Edmonds가 꽃봉오리(blossom)에 대한 선구적인 연구 [``Paths, trees and
flowers,'' {\sl Canadian Journal on Mathematics\/} {\bf 17} (1965), 449--467]에서
찾아낸 구조를 이용해서 말이다. 그 꿈은 Harold N. Gabow와 Robert E. Tarjan이
``Faster scaling algorithms for general graph-matching problems'' [{\sl Journal
of the ACM\/} {\bf 38} (1991), 815--853]를 펴내면서 마침내 이루어졌다. 훨씬 더
일반적인 문제의 해법을 앞세운 논문이다. 더 간추린 설명은 Harold N. Gabow,
``The weighted matching approach to maximum cardinality matching,''
{\sl Fundamenta Informaticae\/} {\bf 154} (2017), 109--130에 있다.

@* 덤 --- 쾨니그의 증명서.
여기서부터는 원본에 없다. 프로그램이 ``크기 $5$짜리 최대 짝짓기를 찾았다''고
말할 때, 우리는 그 말을 믿을 수밖에 없다. 그런데 조금만 더 하면 {\it 증명서\/}를
함께 내놓을 수 있다.

K\H onig의 정리는 이분 그래프에서 최대 짝짓기의 크기가 최소 꼭짓점 덮개---모든
변이 적어도 한쪽 끝을 담그도록 고른 꼭짓점의 가장 작은 모임---의 크기와 같다고
말한다. 짝짓기 하나와 그와 크기가 같은 덮개 하나를 나란히 내놓으면, 짝짓기가
최대라는 것이 그 자리에서 증명된다. 덮개의 꼭짓점 하나는 짝지어진 변을 많아야
하나 덮으니 어떤 덮개도 어떤 짝짓기보다 작을 수 없기 때문이다.

@ 놀라운 것은 그 덮개가 이미 우리 손안에 있다는 사실이다. 마지막 판의 너비 우선
탐색은 증대 경로를 못 찾고 끝났는데, 그때 그 탐색이 훑어 놓은 것이 정확히 필요한
것이다. 짝 없는 소녀에서 출발해 번갈아 걷기로 닿을 수 있는 꼭짓점의 모임을~$Z$라
하면, 덮개는
$$(\hbox{$Z$ 밖의 소녀들})\;\cup\;(\hbox{$Z$ 안의 소년들})$$
이다. 탐색이 끝난 자리에서 $Z$ 안의 소녀들은 |queue|의 앞 |q|칸에 그대로 있고,
$Z$ 안의 소년들은 |mark|가 $0$이 아닌 이들이다.

@ 크기가 맞는지 세어 보자. 모임 $Z$ 안의 소녀는 짝 없는 소녀 $f$명과 $Z$ 안 소년들의
짝들이다. 증대 경로가 없으니 $Z$ 안의 소년은 모두 짝이 있고 그 짝은 $Z$ 안에
있으므로, $Z$ 안 소녀의 수는 $f+\vert Z\cap\hbox{소년}\vert$이다. 따라서 덮개의
크기는
$$\bigl(n-f-\vert Z\cap\hbox{소년}\vert\bigr)+\vert Z\cap\hbox{소년}\vert=n-f$$
로 짝짓기의 크기와 딱 같다.

@ 판이 끝까지 돌아 모든 소년이 짝을 얻은 경우에는 마지막 탐색이 없다. 그때는
소년 전부가 덮개다. 모든 변이 소년 하나를 지나고, 그 크기가 $m=n-f$이니 역시
최소다.

@<최소 꼭짓점 덮개를 알린다@>=
fmt.Fprintf(os.Stderr, "크기 %d짜리 최소 꼭짓점 덮개:", n-f)
if f == n-m {
	@<소년 모두가 덮개다@>@;
} else {
	@<마지막 탐색이 남긴 것으로 덮개를 만든다@>@;
}
fmt.Fprintln(os.Stderr)

@ @<소년 모두가 덮개다@>=
for b = 1; b <= m; b++ {
	fmt.Fprintf(os.Stderr, " b%d", b)
}

@ @<마지막 탐색이 남긴 것으로 덮개를 만든다@>=
for i = 0; i < q; i++ {
	inz[queue[i]] = true
}
for b = 1; b <= m; b++ {
	if mark[b] != 0 {
		fmt.Fprintf(os.Stderr, " b%d", b)
	}
}
for g = 1; g <= n; g++ {
	if !inz[g] {
		fmt.Fprintf(os.Stderr, " g%d", g)
	}
}

@ @<전역 변수@>=
var inz [maxn]bool // 소녀가 $Z$ 안에 있는가

@* 돌려 보기.
행렬을 표준 입력으로 넣고, 첫 인자로 말수준 비트를 주면 된다.
$$\vbox{\halign{\.{#}\hfil\cr
go run hopcroft-karp.go 0x3f < matrix\cr}}$$
소년 여섯과 소녀 여섯으로 된 이런 행렬을 넣어 보자.
$$\vbox{\halign{\.{#}\hfil\cr
000110\cr 100010\cr 001101\cr 001001\cr 001001\cr 001001\cr}}$$
소년 $4$, $5$, $6$이 모두 소녀 $3$과 $6$만 바라보고 있으니, 셋 가운데 하나는
반드시 남는다. 최대 짝짓기는 다섯 쌍이다.

@ 첫 판은 모두가 짝이 없는 상태에서 시작하므로 최단 증대 경로가 모두 등급~$1$,
곧 변 하나짜리다. 층 그래프 dag가 곧 그래프 자신이고, 깊이 우선 탐색은 그저 욕심껏 짝을
지어 나간다. 네 쌍이 지어진다.
$$\vbox{\halign{\.{#}\hfil\cr
1번째 판을 시작한다...\cr
짝 1-5, 짝 3-6, 짝 4-3, 짝 2-1\cr
... 이제 4쌍이 짝지어졌다 (등급 1).\cr}}$$

@ 두 번째 판이 흥미롭다. 짝 없는 소녀는 $2$와 $4$, 짝 없는 소년은 $5$와 $6$이다.
소녀~$2$를 원하는 소년은 없으므로 dag는 소녀~$4$에서만 자란다.
$$\mplibcode fig_dag; \endmplibcode$$
\figcap{두 번째 판의 dag. 소년에서 소녀로 가는 화살은 짝 아닌 변이고, 소녀에서
그의 짝으로 가는 겹화살은 짝인 변이다. 소년 $1$은 dag에 들어와 있지만 $\top$에서
닿을 수 없어 쓸모가 없다. 깊이 우선 탐색은 $\top\to b_5$로 내려가 굵은 길을
찾아내고, 그다음 $\top\to b_6$은 $g_6$이 이미 쓰였으므로 빈손으로 돌아온다.}

@ 그래서 두 번째 판은 등급~$2$짜리 증대 경로 하나를 거두고 다섯 쌍이 된다.
세 번째 판은 dag를 지어 보지만 짝 없는 소년에 닿지 못하고 끝난다.
$$\vbox{\halign{\.{#}\hfil\cr
2번째 판을 시작한다...\cr
짝 3-4, 5-6\cr
... 이제 5쌍이 짝지어졌다 (등급 2).\cr
3번째 판을 시작한다...\cr
크기 5짜리 최대 짝짓기를 3판 만에 찾았다.\cr
5 1 4 3 6 0\cr
크기 5짜리 최소 꼭짓점 덮개: g1 g3 g4 g5 g6\cr}}$$
마지막 줄이 증명서다. 소녀 $1$, $3$, $4$, $5$, $6$ 다섯이 모든 변을 덮으므로
짝짓기는 다섯을 넘을 수 없다. 그리고 우리는 다섯을 이루었다. 소녀~$2$를 원하는
소년이 없으니 덮개에서 빠진 것도 그럴듯하다.

@ 한 가지 덧붙이자면, HK 알고리즘은 단위 용량 네트워크에 Dinic의 흐름 알고리즘을
그대로 돌린 것과 같다. 층을 나눈 그래프를 짓고 거기서 막힌 흐름을 찾는 일이
바로 우리의 dag와 깊이 우선 탐색이다. 일반 그래프로 넓힌
$O(\sqrt{V}E)$ 알고리즘은 1980년에 Silvio Micali와 Vijay Vazirani가 내놓았는데,
그 정확성 증명이 온전히 자리 잡기까지는 다시 여러 해가 걸렸다.

@* 크누스의 숙제.
크누스는 원본을 이런 말로 맺었다. ``더 파 볼 만한 생각이 하나 있다. 짝의 절반
이상이 이미 첫 판에서 지어진다는 것을 우리는 보았다. 그런데 첫 판은 모두가 짝
없이 시작하므로 뒤의 판들보다 훨씬 단순하다. 그러니 첫 판만 따로 손질한 구현으로
더 빨리 해치우면 좋은 출발을 끊을 수 있겠다.''

해 보자. 열쇠는 첫 판에서 |finalLevel|이 반드시 $0$이라는 데 있다.

@ 왜 그런가. 첫 판이 시작될 때는 모두가 짝이 없다. 그러니 너비 우선 탐색이 $0$층의
짝 없는 소녀에게서 처음 만나는 소년이 곧 짝 없는 소년이고, 거기서 |finalLevel|이
$0$으로 정해진다. 층 그래프 dag는 한 층도 더 자라지 않는다.

그러면 깊이 우선 탐색은 어떤가. 층을 내려가는 유일한 길은 소녀~|g|의 짝에게로
가는 것인데, 첫 판에서 짝이 있는 소녀는 {\it 이 판에서 방금 짝지어진\/} 소녀뿐이고
그의 짝은 |mark|가 $-1$이다. 그런 소년은 건너뛴다. 그러니 |l|은 $0$에서 한 번도
내려가지 않는다.

@ 결국 첫 판이 하는 일은 이것뿐이다: {\it 짝 없는 소녀와 짝 없는 소년을 잇는 변을
겹치지 않게 더 못 고를 때까지 고른다.\/} 곧 욕심쟁이 극대 짝짓기다. 그것을 dag를
지어 가며 에둘러 하고 있었던 셈이다. 화살 $t$개를 |tip|과 |next|에 적어 넣고는
곧바로 도로 읽어 버린다.

@ 우리에게 있는 자료 구조는 소녀에서 소년으로 가는 목록 |glink|뿐이니, 방향을
뒤집어 소녀 쪽에서 훑는다. 소녀마다 아직 짝 없는 첫 소년을 집으면 된다. 밭 |tip|과
|next|에는 한 글자도 쓰지 않고, |mark|와 |marked|와 |blink|는 건드리지도 않는다.

@<욕심쟁이로 극대 짝짓기를 만든다@>=
for g = 1; g <= n; g++ {
	for k = glink[g]; k != 0; k = next[k] {
		b = tip[k]
		if mate[b] == 0 {
			mate[b] = g
			imate[g] = b
			@<짝 없는 소녀 목록에서 |g|를 뺀다@>@;
			break
		}
	}
}

@ 이래도 극대다. 짝을 못 얻고 지나간 소녀는 그 순간 이웃이 모두 차 있었다는
뜻인데, 욕심쟁이는 한번 지은 짝을 풀지 않으니 그 소년들은 끝까지 짝이 있다.
그러므로 이 판이 끝난 뒤 짝 없는 소녀와 짝 없는 소년을 잇는 변은 하나도 남지
않는다---원래 첫 판이 보장하던 것과 똑같다.

변수 |finalLevel|을 $0$으로 놓아 주는 것은 판이 끝났음을 알리는 대목이 등급을
찍기 때문이다. 첫 판의 증대 경로는 변 하나짜리이니 등급~$1$이다.

@<첫 판이라면 욕심껏 해치우고 다음 판으로@>=
if r == 1 && greedy {
	@<욕심쟁이로 극대 짝짓기를 만든다@>@;
	finalLevel = 0
	@<판이 끝났음을 알린다@>@;
	continue
}

@ 재 보았다. 아래는 짝짓기 단계만 잰 것이고(입력 읽기는 뺐다), 소녀와 소년이
같은 수인 무작위 그래프다. 소녀 천 명이 이 프로그램의 한계이므로 |maxn|과 |maxt|를
키운 사본으로 쟀다.
$$\vbox{\halign{\hfil#\quad&\hfil#\quad&\hfil#\quad&\hfil#\quad&\hfil#\cr
\noalign{\hrule\smallskip}
그래프&짝짓기 크기&원본&\.{-g}&배\cr
\noalign{\smallskip\hrule\smallskip}
$n=6000$, 차수 $3$&$5638$&$0.65$&$0.35$&$1.88$\cr
$n=6000$, 차수 $8$&$5997$&$1.53$&$0.97$&$1.57$\cr
$n=6000$, 차수 $30$&$6000$&$4.40$&$2.54$&$1.73$\cr
$n=6000$, 차수 $100$&$6000$&$21.83$&$9.51$&$2.30$\cr
$n=3000$, 차수 $300$&$3000$&$33.81$&$16.75$&$2.02$\cr
\noalign{\smallskip\hrule}}}$$
`원본'과 \.{-g} 칸은 밀리초다.

@ 첫 판만 따로 재면 더 또렷하다. 꼭짓점이 $n=6000$이고 차수가~$100$인 그래프에서
첫 판이
$15.15$밀리초에서 $3.88$밀리초로 줄어, 거의 네 배다. 전체에서 차지하던 몫도
$69$\%에서 $41$\%로 내려간다. 첫 판이 가장 비싸다는 크누스의 짐작이 맞았다.

@ 공짜는 아니다. 욕심쟁이가 집는 차례가 dag가 집던 차례와 달라 출발점이 다른
짝짓기가 되므로, 판의 수가 달라질 수 있다. 무작위 그래프 육백 개를 세어 보았다.
$$\vbox{\halign{#\hfil\quad&\hfil#\cr
\noalign{\hrule\smallskip}
판수 차이&그래프 수\cr
\noalign{\smallskip\hrule\smallskip}
한 판 줄어듦&$10$\cr
그대로&$485$\cr
한 판 늘어남&$97$\cr
두 판 늘어남&$8$\cr
\noalign{\smallskip\hrule}}}$$
작은 그래프에서 한두 판 느는 일이 열에 둘쯤 있다. 그래도 늘어난 판은 dag가 작아
싸고, 앞 표의 큰 그래프들에서는 판수가 하나도 달라지지 않았다. 남는 장사다.

@ 마지막 짝짓기의 크기는 물론 언제나 같다. 무작위 그래프 팔백 개로 확인했고,
덤으로 얻는 쾨니그의 덮개도 모두 유효했다. 당연한 일이다. 어느 극대 짝짓기에서
출발하든 HK는 증대 경로가 없어질 때까지 돌고, 보조정리 1이 그때가 최대임을
보장하기 때문이다. 출발점은 속도만 바꾸지 답을 바꾸지 못한다.

@* 색인.
