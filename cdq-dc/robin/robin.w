\input kotexgweb
\input luamplib.sty

\def\title{셔우드의 장부: 호기심 많은 로빈 후드}

@* 들어가며.
로빈 후드는 13세기 무렵부터 잉글랜드의 발라드가 노래해 온 의적이다. 셔우드
숲에 숨어 노팅엄 주장관을 골탕 먹이고, 부자의 금화를 털어 가난한 이에게
나누어 주었다는---역사가들은 실존을 다투지만 이야기꾼들은 조금도 개의치
않았던---그 사나이다. LightOJ의 연습문제 1112 ``호기심 많은 로빈 후드
(Curious Robin Hood)''는 이 의적에게 회계 장부를 맡긴다. 의적에게도 회계는
필요하다. 아니, 벌이가 장물이고 지출이 자선이라면 더욱 필요하다.

로빈은 훔친 금화를 자루 $n$개에 나누어 두었다($0$번부터 $n-1$번까지;
$1\le n\le10^5$, 자루의 처음 금액은 $0$ 이상 $1000$ 이하). 그리고 질의가
$q$개 날아든다($1\le q\le50000$). ``\.{1 i}''는 $i$번 자루를 통째로 가난한 이에게
준다는 뜻---든 금액을 보고하고 자루는 빈다. ``\.{2 i v}''는 새 장물 $v$를 $i$번
자루에 보탠다($1\le v\le1000$). ``\.{3 i j}''는 로빈의 호기심이다: $i$번부터
$j$번까지 자루의 총액이 궁금하다. 입력은 이런 사건(test case) $T$벌로
이루어지고($T\le5$; 각 벌의 첫 줄에 $n$과 $q$, 둘째 줄에 처음 금액 $n$개,
이어서 질의 $q$줄), 벌마다 ``\.{Case x:}'' 한 줄을 쓴 뒤 \.{1}형과 \.{3}형
질의의 답을 한 줄씩 낸다.

이 문서는 총서의 번외편이다. 《맥상화개》에서 셋째 축을 맡기며 ``설명은
줄인다'' 했고, 《쾌도참난마》에서는 ``글자 하나 안 고치고 옮겨 왔다''며 세
번을 부려 먹은 조연, 펜윅 트리가 이번에는 단독 주연이다. 축이 하나뿐인 이
문제에는 정렬도 분할정복도 등장하지 않는다---그동안 미뤄 둔 빚, 저 여덟 줄이
{\it 왜\/} 도는지를 갚기에 꼭 알맞은 무대다.
@c
package main

import (
	"bufio"
	"fmt"
	"os"
	"strconv"
)

@<자료구조@>@;

func main() {
	@<입출력을 준비한다@>

	for tc, T := 1, readInt(); tc <= T; tc++ {
		@<사건 한 벌을 읽어 풀고 출력한다@>
	}
}

@ 소박한 풀이 둘부터 저울에 달아 보자. 자루를 배열로 두면 갱신은 $O(1)$이지만
총액 질의마다 $O(n)$을 훑어야 하고, 반대로 접두사 합 표를 미리 만들어 두면
질의는 $O(1)$이지만 자루 하나가 바뀔 때마다 표 절반을 $O(n)$에 고쳐야 한다.
$n$은 $10^5$이고 $q$ 는 $5\cdot10^4$이니 어느 쪽이든 최악에 $5\cdot10^9$
---파산이다. 구간 합은 접두사 합 둘의 차 $S_j-S_{i-1}$로 환원되므로,
필요한 것은 {\it 점 갱신과 접두사 합이 둘 다 빠른} 장부 하나다.

그 장부를 1994년에 뉴질랜드 오클랜드 대학의 Peter Fenwick이 내놓았다.
본래 목적은 의적질과 무관한 산술 부호화(arithmetic coding) 압축---기호의
누적 빈도표를 빠르게 갱신하고 조회하는 일---이었지만, 좋은 도구는 주인을
가리지 않는 법이다. 두 연산 모두 $O(\log n)$, 공간은 원소당 정수 하나,
포인터는 한 개도 없다.

@* 펜윅 트리.
비결은 색인의 이진 표현에 있다. $lowbit(i)=i\mathbin{\&}{-i}$를 $i$의
최하위 1비트라 하자(2의 보수 표현에서 $-i$는 $i$의 비트를 뒤집고 1을 더한
것이라, $\mathbin\&$를 취하면 꼭 그 비트만 남는다). 길이 $n$의 배열
$t$를 두되, $t[i]$에는 원소 하나가 아니라 {\it 구간
$(i-lowbit(i),\,i]$의 합}을 담는다. 그림이 $n=16$일 때의 배치다---%
상자 안의 수가 색인 $i$이고, 상자의 가로 폭이 그 상자가 책임지는 구간이다.

$$
\mplibcode
% 펜윅 트리의 책임 구간 (n=16).
% 상자 t[i]는 구간 (i-lowbit(i), i]의 합을 책임지고, 상자 안의 수가 색인 i다.
% 회색 상자 셋은 접두사 합 sum(13) = t[13]+t[12]+t[8]의 분해.

beginfig(1);
  numeric u, h, dy;
  u := 7mm; h := 3.6mm; dy := 6mm;

  % 구간 (a, b]를 책임지는 상자를 높이 lev에 그린다
  def bar(expr a, b, lev, shaded) =
    begingroup
      save p; path p;
      p := (a*u, lev*dy)--(b*u, lev*dy)--(b*u, lev*dy+h)--(a*u, lev*dy+h)--cycle;
      if shaded: fill p withcolor .85white; fi
      draw p;
      label(decimal b, ((b-.5)*u, lev*dy+.5h));
    endgroup
  enddef;

  for i = 1 step 2 until 15: bar(i-1, i, 0, (i=13)); endfor  % lowbit 1
  for i = 2 step 4 until 14: bar(i-2, i, 1, false); endfor   % lowbit 2
  for i = 4 step 8 until 12: bar(i-4, i, 2, (i=12)); endfor  % lowbit 4
  bar(0, 8, 3, true);                                        % lowbit 8
  bar(0, 16, 4, false);                                      % lowbit 16
endfig;
\endmplibcode
$$

접두사 합 $S_{13}$을 구해 보자. $13=8+4+1$이니 구간 $[1,13]$은
$[1,8]$, $[9,12]$, $[13,13]$---그림의 회색 상자 셋---으로 쪼개지고, 그
색인들은 $13$에서 $lowbit$를 거듭 벗겨 낸 $13\to12\to8$이다. 이진 표현의
1비트 하나가 조각 하나이므로 어떤 접두사든 $O(\log n)$조각이면 덮인다.
거꾸로 자루 $5$가 바뀌면 $5$를 폭 안에 담은 상자들을 모두 고쳐야 하는데,
그림에서 짚어 보면 $5$, $6$, $8$, $16$---이번에는 $lowbit$를 거듭 {\it 더한}
색인들이다. $i$에 $lowbit(i)$를 더하면 그 1비트가 윗자리로 올림되며
더 넓은 상자로 옮겨 가는 것인데, 그렇게 얻는 상자가 $i$를 덮는 바로 다음
상자라는 것은 그림을 놓고 몇 분 끄적이면 확인된다(엄밀한 증명도 그 끄적임을
받아 적으면 된다). 요컨대 합은 $lowbit$를 빼며 내려가고, 갱신은 $lowbit$를
더하며 올라간다. 트리라 부르지만 실체는 배열 하나---부모 자식 관계가
비트 연산에 통째로 접혀 들어간 암묵 트리다.

@ 세 문서에서 세 번 옮겨 적은 바로 그 여덟 줄을, 이번에는 설명을 갖추고 적는다.
@<자료구조@>=
type bit []int // 1 기반 색인; 0번 칸은 놀린다

func (t bit) add(i, v int) {
	for ; i < len(t); i += i & -i {
		t[i] += v
	}
}

func (t bit) sum(i int) int {
	s := 0
	for ; i > 0; i -= i & -i {
		s += t[i]
	}
	return s
}

@ 이번에는 처음부터 자루에 금액이 들어 있으므로 건설자가 필요하다. |add|를
$n$번 부르면 $O(n\log n)$이지만, 그럴 것 없이 $O(n)$에 세울 수 있다: 각
상자는 제 폭 안에 든 한 단계 작은 상자들의 합이므로, $t[i]$가 완성되는
순간---색인 오름차순이면 보장된다---자기를 덮는 다음 상자 $i+lowbit(i)$에
제 몫을 전파하면 끝이다.
@<자료구조@>=
func newBIT(a []int) bit {
	t := make(bit, len(a)+1)
	for i := range a {
		t[i+1] += a[i]
		if j := i + 1 + (i+1)&-(i+1); j < len(t) {
			t[j] += t[i+1]
		}
	}
	return t
}

@ 트리 곁에 평범한 배열 |cur|를 나란히 둔다. \.{1}형이 ``지금 이 자루에 얼마
들었나''를 묻는데, 트리로도 $S_i-S_{i-1}$로 알아낼 수 있지만 낱 자루의 현재
금액쯤은 배열이 $O(1)$에, 그리고 더 정직하게 기억한다. 트리는 접두사 합
전담이다.

질의를 어디 모아 둘 필요조차 없다는 점을 눈여겨보라. 트리는 온라인이니,
오는 족족 답하면 된다.
@<사건 한 벌을 읽어 풀고 출력한다@>=
fmt.Fprintf(out, "Case %d:\n", tc)
n, q := readInt(), readInt()
cur := make([]int, n)
for i := range cur {
	cur[i] = readInt()
}
tree := newBIT(cur)
for ; q > 0; q-- {
	@<질의 하나를 읽어 처리한다@>
}

@ 문제의 자루 번호는 0 기반, 트리는 1 기반이므로 아래 세 절이 저마다 한 칸을
옮긴다.
@<질의 하나를 읽어 처리한다@>=
switch readInt() {
case 1:
	@<자루를 비워 가난한 이에게 준다@>
case 2:
	@<자루에 장물을 보탠다@>
default:
	@<로빈의 호기심에 답한다@>
}

@ 비우기는 ``현재 금액만큼 빼기''라는 갱신이다.
@<자루를 비워 가난한 이에게 준다@>=
i := readInt()
fmt.Fprintln(out, cur[i])
tree.add(i+1, -cur[i])
cur[i] = 0

@ @<자루에 장물을 보탠다@>=
i, v := readInt(), readInt()
cur[i] += v
tree.add(i+1, v)

@ @<로빈의 호기심에 답한다@>=
i, j := readInt(), readInt()
fmt.Fprintln(out, tree.sum(j+1)-tree.sum(i))

@ 읽기는 앞의 문서들과 같다. 답의 크기를 가늠해 두면, 자루 총액은 처음 금액
$10^8$에 \.{2}형이 보태는 최대 $10^8$을 더해도 $2\times10^8$---|int|로
넉넉하다.
@<입출력을...@>=
sc := bufio.NewScanner(os.Stdin)
readInt := func() int {
	sc.Scan()
	n, _ := strconv.Atoi(sc.Text())
	return n
}

sc.Split(bufio.ScanWords)
out := bufio.NewWriter(os.Stdout)
defer out.Flush()

@ 총서의 사다리에 이 문제를 놓아 보면 맨 아래 칸이다. 축이 자루 번호
하나뿐이니 정렬할 것도 분할할 것도 없고, 자료구조 홀로 서는 무대다. 그런데
사다리는 아래로도 위로도 이어져 있다. 《쾌도참난마》의 표어대로 시간을
축으로 승격하면 이 문제조차 (시각, 자루 번호)의 2차원 편서가 된다---갱신은
점이요 질의는 접두사이니, 《창백한 푸른 점》의 병합정렬이 오프라인으로
그대로 먹힌다. \.{1}형이 비우는 금액이 질의 답에 얽혀 있는 듯 보여도, 실은
그 자루 제 역사만으로 미리 셈해 둘 수 있으므로 오프라인화에 걸림돌이 없다.
거꾸로 말하면, 질의가 실시간으로 날아와 즉답해야 하는 순간---CDQ가 자리를
비켜 주는 바로 그 순간---남아서 일하는 것이 펜윅 트리다. 총서 내내 조연과
주연이 갈린 기준은 결국 이것 하나였다: 시간을 미리 손에 쥘 수 있는가.

펜윅은 압축 알고리즘을 위해 이 트리를 만들었지만, 지금은 온 세상의 경시
프로그래머들이 아무 데나 꺼내 쓰는 공용 연장이 되었다. 부자의 곳간에서 나와
만인의 자루로---로빈이 들었다면 흐뭇해했을 결말이다.

@* 찾아보기.
